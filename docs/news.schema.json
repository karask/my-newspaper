{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/the-daily-signal/news.schema.json",
  "title": "The Daily Signal edition",
  "description": "Versioned contract for one complete daily edition. The runtime validator in scripts/build.py is authoritative during ingest and build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition", "sections", "lead_story_id", "stories"],
  "properties": {
    "schema_version": {"const": 1},
    "edition": {"$ref": "#/$defs/edition"},
    "sections": {
      "type": "array",
      "prefixItems": [
        {"const": "Bitcoin"},
        {"const": "AI"},
        {"const": "Robotics"},
        {"const": "Longevity"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "lead_story_id": {"type": "string", "minLength": 1},
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/story"}
    }
  },
  "$defs": {
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title", "kicker", "status", "updated_at"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "title": {"type": "string", "minLength": 1},
        "kicker": {"type": "string", "minLength": 1},
        "status": {"enum": ["demo", "live"]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "confidence", "note"],
      "properties": {
        "signal": {"enum": ["primary", "corroborated", "developing", "analysis"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "popularity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "engagement", "label", "observed_at", "evidence_url"],
      "properties": {
        "platform": {"enum": ["x", "reddit", "youtube", "mixed"]},
        "engagement": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "section", "rank", "story_type", "title", "summary", "source",
        "canonical_url", "published_at", "corroboration", "quality", "tags"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "section": {"enum": ["Bitcoin", "AI", "Robotics", "Longevity"]},
        "rank": {"type": "integer", "minimum": 1},
        "story_type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "summary": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/link"},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "published_at": {"type": "string", "format": "date-time"},
        "corroboration": {
          "type": "array",
          "items": {"$ref": "#/$defs/link"}
        },
        "quality": {"$ref": "#/$defs/quality"},
        "popularity": {"$ref": "#/$defs/popularity"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
